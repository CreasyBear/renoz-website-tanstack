{
  "name": "renoz-website-tanstack",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "optimize:logo": "node scripts/optimize-logo.mjs",
    "sitemap:generate": "bun -e \"import { mkdirSync, writeFileSync } from 'node:fs'; import { buildStaticSitemapXml } from './src/lib/seo.ts'; mkdirSync('tmp', { recursive: true }); writeFileSync('tmp/sitemap.xml', buildStaticSitemapXml()); console.log('Wrote tmp/sitemap.xml');\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slot": "^1.3.1",
    "@react-email/components": "^1.0.12",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "liveline": "^0.0.7",
    "lucide-react": "^0.544.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^3.25.76"

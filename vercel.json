{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "redirects": [
    {
      "source": "/residential",
      "destination": "/products/residential",
      "permanent": true
    },
    {
      "source": "/commercial",
      "destination": "/products/commercial",
      "permanent": true
    },
    {
      "source": "/rural",
      "destination": "/products/rural",
      "permanent": true
    },
    {
      "source": "/wa-battery-subsidy",
      "destination": "/guides/wa-battery-rebates-cec",
      "permanent": true
    },
    {
      "source": "/energy-calculator",
      "destination": "/homeowners",
      "permanent": true
    },
    {
      "source": "/sitemap/xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/reasoning.json",
      "destination": "/.well-known/reasoning.json"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
